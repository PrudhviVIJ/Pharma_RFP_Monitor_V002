# Copy this file to .env and replace every placeholder with a local value.
INPUT_XLSX=RFP Scrape Pharma URLs.xlsx
USE_PLAYWRIGHT_FALLBACK=true
REQUEST_TIMEOUT=25
DELAY_SECONDS=1.0
MAX_LINKS_PER_SEED=20
MAX_DISCOVERED_URLS=200
MAX_TEXT_CHARS=1500000
MAX_RESPONSE_BYTES=15000000
MAX_REDIRECTS=5
MAX_FAILURE_RATIO=0.50
ALERT_MIN_LEAD_DAYS=7
REQUIRE_VERIFIABLE_ALERT_DEADLINE=true
USER_AGENT=PharmaRFPMonitor/1.0 (polite public-page monitoring)

# Optional Google Sheets integration
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=Pharma RFP Monitor
GOOGLE_SHEETS_EMAIL_WORKSHEET=Email Alerts
GOOGLE_SHEETS_EMAIL_HISTORY_WORKSHEET=Email Alerts History
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/google_service_account.json

# Optional SMTP notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=

# Optional Gemini review/discovery
GEMINI_API_KEY=
# Gemini model used for Google Search grounding and structured review.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DISCOVERY=true
GEMINI_REVIEW=false

# Optional PostgreSQL persistence. Use a TLS-enabled DSN in production.
POSTGRES_ENABLED=false
# For remote databases use sslmode=require or sslmode=verify-full in the DSN.
POSTGRES_DSN=postgresql://username:password@localhost:5432/pharma_rfp_monitor
